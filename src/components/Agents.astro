---
import { AGENTS_SCENE } from "../content/sections";
import { DEMO_SNAPSHOT } from "../panel/data";
import { MacCrop, SessionsNowCrop } from "../panel/Panel";
import CropPair from "./CropPair.astro";
import Section from "./Section.astro";

const { now, mac } = AGENTS_SCENE.blocks;
---

<Section
  id={AGENTS_SCENE.id}
  eyebrow={AGENTS_SCENE.eyebrow}
  title={AGENTS_SCENE.title}
  lede={AGENTS_SCENE.lede}
  layout="stack"
  tier="support"
>
  <CropPair under={now} over={mac}>
    <SessionsNowCrop slot="under" snapshot={DEMO_SNAPSHOT} label={now.panelLabel} />
    <MacCrop slot="over" snapshot={DEMO_SNAPSHOT} label={mac.panelLabel} />
  </CropPair>
</Section>
