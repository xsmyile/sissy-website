---
import { AGENTS_SCENE } from "../content/sections";
import { DEMO_SNAPSHOT } from "../panel/data";
import { Panel } from "../panel/Panel";
import Section from "./Section.astro";
---

<Section
  id={AGENTS_SCENE.id}
  eyebrow={AGENTS_SCENE.eyebrow}
  title={AGENTS_SCENE.title}
  lede={AGENTS_SCENE.lede}
  layout="reverse"
  tier="support"
>
  <p class="body" slot="aside">{AGENTS_SCENE.body}</p>
  <div class="stage">
    <Panel
      snapshot={DEMO_SNAPSHOT}
      tab="sessions"
      showsAllProcesses
      label={AGENTS_SCENE.panelLabel}
    />
  </div>
</Section>

<style>
  .body {
    margin: 8px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    font-size: 14.5px;
    color: var(--muted);
    text-wrap: pretty;
  }

  .stage {
    --panel-pt: 1.12px;

    display: flex;
    justify-content: center;
    padding: 8px 0 24px;
  }

  @media (max-width: 920px) {
    .stage {
      --panel-pt: 1px;

      padding: 0 0 8px;
    }
  }
</style>
