---
import { PROJECTS } from "../content/sections";
import { DEMO_SNAPSHOT } from "../panel/data";
import { ProjectsCrop } from "../panel/Panel";
import Section from "./Section.astro";
---

<Section
  id={PROJECTS.id}
  eyebrow={PROJECTS.eyebrow}
  title={PROJECTS.title}
  lede={PROJECTS.lede}
  tier="support"
>
  <p class="body" slot="aside">{PROJECTS.body}</p>
  <div class="stage">
    <ProjectsCrop snapshot={DEMO_SNAPSHOT} label={PROJECTS.panelLabel} />
  </div>
</Section>

<style>
  .body {
    margin: 8px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    font-size: 14.5px;
    color: var(--muted);
    text-wrap: pretty;
  }

  .stage {
    --panel-pt: 1.3px;

    display: flex;
    justify-content: center;
  }

  @media (max-width: 920px) {
    .stage {
      --panel-pt: 1.05px;
    }
  }
</style>
