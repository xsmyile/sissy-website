---
import { LIMITS } from "../content/sections";
import { DEMO_SNAPSHOT } from "../panel/data";
import { LimitsCrop } from "../panel/Panel";
import Inline from "./Inline.astro";
import Section from "./Section.astro";

const row = DEMO_SNAPSHOT.gaugeRows.find((entry) => entry.id === LIMITS.rowId);
if (row === undefined) {
  throw new Error(`The fixture has no gauge row "${LIMITS.rowId}" for the pace band to read`);
}

const { windows, resets } = LIMITS.blocks;
const used = Math.round(row.usedFraction * 100);
const expected = row.expectedFraction * 100;
---

<Section
  id={LIMITS.id}
  eyebrow={LIMITS.eyebrow}
  title={LIMITS.title}
  lede={LIMITS.lede}
  layout="stack"
  tier="lead"
>
  <div class="band" data-pace-band>
    <p class="figure"><span data-pace-value>{used}</span><span>%</span></p>
    <p class="said"><Inline text={LIMITS.paceBody} /></p>
    <div class="gauge">
      <div class="fill" data-pace-fill style={`width: ${used}%`}></div>
      <div class="mark" style={`left: ${expected}%`}></div>
    </div>
    <p class="legend">
      <span>{row.name} · {row.window.toLowerCase()} window</span>
      <span class="paced"><i></i>{LIMITS.paceLabel}</span>
    </p>
  </div>

  <div class="page">
    <figure class="under">
      <LimitsCrop
        snapshot={DEMO_SNAPSHOT}
        provider={row.provider}
        account={row.account}
        label={windows.panelLabel}
      />
      <figcaption><b>{windows.title}</b> {windows.body}</figcaption>
    </figure>
    <figure class="over">
      <LimitsCrop
        snapshot={DEMO_SNAPSHOT}
        provider={LIMITS.resetsProvider}
        account={null}
        label={resets.panelLabel}
      />
      <figcaption><b>{resets.title}</b> {resets.body}</figcaption>
    </figure>
  </div>
</Section>

<style>
  .band {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 14px 56px;
    margin-bottom: 56px;
  }

  .figure {
    margin: 0;
    font-size: clamp(76px, 11.5vw, 148px);
    font-weight: 700;
    line-height: 0.8;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }

  .figure span:last-child {
    font-size: 0.46em;
    letter-spacing: -0.02em;
    vertical-align: 0.42em;
  }

  .said {
    margin: 0;
    max-width: 30em;
    font-size: 17px;
    line-height: 1.5;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .gauge {
    grid-column: 1 / -1;
    position: relative;
    height: 14px;
    margin-top: 30px;
    border-radius: 999px;
    background: var(--surface-2);
  }

  .fill {
    position: absolute;
    inset: 0 auto 0 0;
    border-radius: 999px;
    transform-origin: left;
    background: linear-gradient(90deg, var(--accent-deep), var(--accent));
  }

  .mark {
    position: absolute;
    top: -6px;
    bottom: -6px;
    width: 3px;
    border-radius: 2px;
    background: var(--over-pace);
  }

  .legend {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: 15px 0 0;
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .paced i {
    display: inline-block;
    width: 3px;
    height: 10px;
    margin-right: 7px;
    border-radius: 2px;
    background: var(--over-pace);
    vertical-align: -1px;
  }

  /*
   * Codex's limits lie over Claude's, down and to the right, the way two
   * pages of one panel would stack, and cover only the edge of Claude's frame
   * that carries no text. Its caption sits beside it rather than under it,
   * which is what keeps the pair no taller than one crop and a caption. The
   * crop on top carries a short shadow of its own, because two contact
   * shadows alone do not say which edge is on top.
   */
  .page {
    display: flex;
    align-items: flex-start;
  }

  figure {
    --panel-pt: 1.12px;

    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    align-content: start;
    justify-items: start;
    flex: none;
    margin: 0;
  }

  .over {
    position: relative;
    display: flex;
    flex: 1 1 auto;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 40px;
    min-width: 0;
    margin: 48px 0 0 calc(-6 * var(--panel-pt));
  }

  .over :global(.panel) {
    box-shadow:
      0 calc(2 * var(--pt)) calc(6 * var(--pt)) rgba(0, 0, 0, 0.4),
      0 14px 36px rgba(0, 0, 0, 0.5);
  }

  figcaption {
    max-width: calc(340 * var(--panel-pt));
    font-size: 14.5px;
    color: var(--muted);
    text-wrap: pretty;
  }

  .under figcaption {
    max-width: calc(310 * var(--panel-pt));
  }

  .over figcaption {
    flex: 1 1 220px;
  }

  figcaption b {
    font-weight: 600;
    color: var(--text);
  }

  @media (max-width: 920px) {
    .band {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
      margin-bottom: 40px;
    }

    .page {
      flex-direction: column;
      gap: 32px;
    }

    figure {
      --panel-pt: 1px;
    }

    .over {
      flex-direction: column;
      align-items: flex-start;
      margin: 0;
    }

    .under figcaption {
      max-width: calc(340 * var(--panel-pt));
    }

    .over figcaption {
      flex: none;
    }
  }
</style>
