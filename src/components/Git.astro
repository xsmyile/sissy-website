---
import { GIT } from "../content/sections";
import { DEMO_SETTINGS, DEMO_SNAPSHOT } from "../panel/data";
import { ForgeCrop, IdentitiesCrop, ProjectsCrop } from "../panel/Panel";
import { ForgeSettingsCrop } from "../settings/Settings";
import Inline from "./Inline.astro";
import Section from "./Section.astro";

const { projects, contributions } = GIT.blocks;
---

<Section id={GIT.id} eyebrow={GIT.eyebrow} title={GIT.title} lede={GIT.lede} tier="lead">
  <p class="body" slot="aside"><Inline text={GIT.body} /></p>
  <div class="stage">
    <IdentitiesCrop snapshot={DEMO_SNAPSHOT} label={GIT.panelLabel} />
  </div>
  <div class="after" slot="after">
    <figure>
      <ProjectsCrop snapshot={DEMO_SNAPSHOT} label={projects.panelLabel} />
      <figcaption><b>{projects.title}</b> {projects.body}</figcaption>
    </figure>
    <figure class="contributions">
      <div class="cascade">
        <ForgeCrop snapshot={DEMO_SNAPSHOT} label={contributions.panelLabel} />
        <div class="over">
          <ForgeSettingsCrop forge={DEMO_SETTINGS.forge} label={contributions.settingsLabel} />
        </div>
      </div>
      <figcaption><b>{contributions.title}</b> <Inline text={contributions.body} /></figcaption>
    </figure>
  </div>
</Section>

<style>
  .body {
    margin: 8px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    font-size: 14.5px;
    color: var(--muted);
    text-wrap: pretty;
  }

  .stage {
    --panel-pt: 1.3px;

    display: flex;
    justify-content: flex-start;
  }

  /*
   * The two blocks that follow take the section's own columns, so the second
   * starts where the page above it does. The contributions block rides up
   * over the identities page's frame, never far enough to cut its last line,
   * and Settings ▸ Forge rides over the block in turn, down and to the right:
   * three surfaces of one app stacked the way their windows would be. A
   * surface laid over another carries a short shadow of its own, because on
   * the graphite ground two contact shadows alone do not say which edge is on
   * top.
   */
  .after {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 40px 64px;
  }

  figure {
    --panel-pt: 1px;

    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    align-content: start;
    justify-items: start;
    margin: 0;
  }

  .contributions {
    position: relative;
    margin-top: -52px;
  }

  .cascade {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: start;
    margin-left: 48px;
  }

  .over {
    position: relative;
    max-width: calc(100% - 72px);
    margin: -28px 0 0 72px;
  }

  .cascade :global(.panel),
  .over :global(.settings) {
    box-shadow:
      0 calc(2 * var(--pt)) calc(6 * var(--pt)) rgba(0, 0, 0, 0.4),
      0 14px 36px rgba(0, 0, 0, 0.5);
  }

  figcaption {
    max-width: calc(340 * var(--panel-pt));
    font-size: 14.5px;
    color: var(--muted);
    text-wrap: pretty;
  }

  figcaption b {
    font-weight: 600;
    color: var(--text);
  }

  @media (max-width: 920px) {
    .stage {
      --panel-pt: 1.05px;
    }

    .after {
      grid-template-columns: minmax(0, 1fr);
    }

    .contributions {
      margin-top: 0;
    }

    .cascade {
      margin-left: 0;
    }

    .over {
      max-width: calc(100% - 24px);
      margin-left: 24px;
    }
  }
</style>
