---
import { YOURS } from "../content/sections";
import { DEMO_SNAPSHOT } from "../panel/data";
import { ForgeCrop } from "../panel/Panel";
import Section from "./Section.astro";
---

<Section
  id={YOURS.id}
  eyebrow={YOURS.eyebrow}
  title={YOURS.title}
  lede={YOURS.lede}
  tier="support"
>
  <p class="body" slot="aside">{YOURS.body}</p>
  <div class="stage">
    <ForgeCrop snapshot={DEMO_SNAPSHOT} label={YOURS.panelLabel} />
  </div>
</Section>

<style>
  .body {
    margin: 8px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    font-size: 14.5px;
    color: var(--muted);
    text-wrap: pretty;
  }

  .stage {
    --panel-pt: 1.3px;

    display: flex;
    justify-content: center;
  }

  @media (max-width: 920px) {
    .stage {
      --panel-pt: 1.05px;
    }
  }
</style>
