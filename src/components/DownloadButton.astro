<style>
  .download {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--bg);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }

  .download:hover {
    background: var(--accent-bright);
  }

  @media (prefers-reduced-motion: no-preference) {
    .download {
      transition: background 0.15s ease;
    }
  }

  .download svg {
    width: 13px;
    height: 16px;
    margin-block-start: -2px;
  }
</style>
