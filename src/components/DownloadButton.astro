---
import { DOWNLOAD_URL } from "../content/site";
---

<a class="download" href={DOWNLOAD_URL}>
  <svg viewBox="0 0 16 16" aria-hidden="true">
    <path
      d="M8 2v8m0 0 3-3M8 10 5 7M3 13h10"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  Download for macOS
</a>

<style>
  .download {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--bg);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }

  .download:hover {
    background: var(--accent-bright);
  }

  @media (prefers-reduced-motion: no-preference) {
    .download {
      transition: background 0.15s ease;
    }
  }

  .download svg {
    width: 16px;
    height: 16px;
  }
</style>
