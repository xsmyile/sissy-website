---
import { ACCOUNTS } from "../content/sections";
import { DEMO_SETTINGS, DEMO_SNAPSHOT } from "../panel/data";
import { IdentityCrop } from "../panel/Panel";
import { ProvidersCrop } from "../settings/Settings";
import Inline from "./Inline.astro";
import Section from "./Section.astro";

const switchable = DEMO_SNAPSHOT.providerPages.find(
  (page) => !page.identity.inCLI && page.identity.switchable,
);
if (switchable === undefined) {
  throw new Error(
    "The fixture has no account the CLI is not signed in as, so the switch cannot be shown",
  );
}
---

<Section
  id={ACCOUNTS.id}
  eyebrow={ACCOUNTS.eyebrow}
  title={ACCOUNTS.title}
  lede={ACCOUNTS.lede}
  tier="lead"
>
  <dl class="points" slot="aside">
    {
      ACCOUNTS.points.map((point) => (
        <div class="point">
          <dt>{point.title}</dt>
          <dd>
            <Inline text={point.body} />
          </dd>
        </div>
      ))
    }
  </dl>
  <div class="stage">
    <IdentityCrop identity={switchable.identity} label={ACCOUNTS.panelLabel} />
    <ProvidersCrop settings={DEMO_SETTINGS} label={ACCOUNTS.settingsLabel} />
  </div>
</Section>

<style>
  .stage {
    --panel-pt: 1.2px;

    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    justify-items: start;
  }

  .points {
    display: grid;
    gap: 20px;
    margin: 8px 0 0;
  }

  .point {
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  dt {
    margin-bottom: 6px;
    font-size: var(--text-base);
    font-weight: 600;
  }

  dd {
    margin: 0;
    font-size: var(--text-base);
    color: var(--text-2);
    text-wrap: pretty;
  }

  @media (max-width: 920px) {
    .stage {
      --panel-pt: 1px;
    }
  }
</style>
