---
import { DETAIL } from "../content/sections";
import Disclosure from "./Disclosure.astro";
import Inline from "./Inline.astro";
import Section from "./Section.astro";
---

<Section
  id={DETAIL.id}
  eyebrow={DETAIL.eyebrow}
  title={DETAIL.title}
  lede={DETAIL.lede}
  layout="stack"
  tier="detail"
>
  <dl class="points">
    {
      DETAIL.points.map((point) => (
        <div class="point">
          <dt>{point.title}</dt>
          <dd><Inline text={point.body} /></dd>
        </div>
      ))
    }
  </dl>
  <Disclosure summary={DETAIL.readsSummary}>
    <dl class="sources">
      {
        DETAIL.sources.map((source) => (
          <div class="source">
            <dt>{source.name}</dt>
            <dd><Inline text={source.where} /></dd>
          </div>
        ))
      }
    </dl>
    <p class="note">{DETAIL.readsNote}</p>
  </Disclosure>
</Section>

<style>
  .points {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px 48px;
    margin: 0 0 40px;
  }

  .point {
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }

  dt {
    margin-bottom: 6px;
    font-size: 15px;
    font-weight: 600;
  }

  dd {
    margin: 0;
    font-size: 14.5px;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .note {
    margin: 0;
    font-size: 14.5px;
    color: var(--muted);
    text-wrap: pretty;
  }

  .sources {
    display: grid;
    margin: 0;
  }

  .source {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 5fr);
    gap: 24px;
    padding-block: 12px;
    border-top: 1px solid var(--border);
    font-size: 14.5px;
  }

  .source:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .source dt {
    margin-bottom: 0;
    color: var(--text);
  }

  @media (max-width: 920px) {
    .points {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      margin-bottom: 32px;
    }
  }

  @media (max-width: 560px) {
    .source {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
    }
  }
</style>
