---
import Sissy from "../assets/brand/sissy-silhouette.svg";
import { NAV_LINKS, NAV_MARK, SITE_NAME, symbolHref } from "../content/site";
---

<nav class="nav wrap">
  <a class="brand" href="/">
    <Sissy class="brand-mark" />
    {SITE_NAME}
  </a>
  <div class="links">
    {NAV_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
    <a class="mark" href={NAV_MARK.href} aria-label={NAV_MARK.label} title={NAV_MARK.label}>
      <svg aria-hidden="true"><use href={symbolHref(NAV_MARK.symbol)} /></svg>
    </a>
  </div>
</nav>

<style>
  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    padding-block: 14px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .brand-mark {
    width: 22px;
    height: 22px;
    color: var(--text);
  }

  .links {
    display: flex;
    gap: 22px;
    align-items: center;
    margin-left: auto;
    font-size: 14px;
    color: var(--text-2);
  }

  .links a {
    text-decoration: none;
  }

  .links a:hover {
    color: var(--text);
  }

  .mark {
    display: grid;
    width: 28px;
    height: 28px;
    margin-block: -4px;
    margin-left: 10px;
    place-items: center;
    transition: color 140ms ease;
  }

  .mark svg {
    width: 17px;
    height: 17px;
  }
</style>
