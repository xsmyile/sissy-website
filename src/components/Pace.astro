---
import { PACE } from "../content/sections";
import { DEMO_SNAPSHOT } from "../panel/data";
import Inline from "./Inline.astro";

const row = DEMO_SNAPSHOT.gaugeRows.find((entry) => entry.id === PACE.rowId);
if (row === undefined) {
  throw new Error(`The fixture has no gauge row "${PACE.rowId}" for the pace band to read`);
}

const used = Math.round(row.usedFraction * 100);
const expected = row.expectedFraction * 100;
---

<section class="pace" id={PACE.id} data-tier="lead" data-pace-band>
  <div class="band wrap">
    <p class="figure" data-reveal><span data-pace-value>{used}</span><span>%</span></p>
    <p class="said" data-reveal><Inline text={PACE.body} /></p>
    <div class="gauge" data-reveal>
      <div class="fill" data-pace-fill style={`width: ${used}%`}></div>
      <div class="mark" style={`left: ${expected}%`}></div>
    </div>
    <p class="legend" data-reveal>
      <span>{row.name} · {row.window.toLowerCase()} window</span>
      <span class="paced"><i></i>{PACE.paceLabel}</span>
    </p>
  </div>
</section>

<style>
  .pace {
    border-top: 1px solid var(--border);
    background: linear-gradient(to bottom, var(--bg-soft), var(--bg));
    padding-block: 64px 72px;
  }

  .band {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 14px 56px;
  }

  .figure {
    margin: 0;
    font-size: clamp(76px, 11.5vw, 148px);
    font-weight: 700;
    line-height: 0.8;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }

  .figure span:last-child {
    font-size: 0.46em;
    letter-spacing: -0.02em;
    vertical-align: 0.42em;
  }

  .said {
    margin: 0;
    max-width: 30em;
    font-size: 17px;
    line-height: 1.5;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .gauge {
    grid-column: 1 / -1;
    position: relative;
    height: 14px;
    margin-top: 30px;
    border-radius: 999px;
    background: var(--surface-2);
  }

  .fill {
    position: absolute;
    inset: 0 auto 0 0;
    border-radius: 999px;
    transform-origin: left;
    background: linear-gradient(90deg, var(--accent-deep), var(--accent));
  }

  .mark {
    position: absolute;
    top: -6px;
    bottom: -6px;
    width: 3px;
    border-radius: 2px;
    background: var(--over-pace);
  }

  .legend {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: 15px 0 0;
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .paced i {
    display: inline-block;
    width: 3px;
    height: 10px;
    margin-right: 7px;
    border-radius: 2px;
    background: var(--over-pace);
    vertical-align: -1px;
  }

  @media (max-width: 920px) {
    .pace {
      padding-block: 48px 56px;
    }

    .band {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }
  }
</style>
